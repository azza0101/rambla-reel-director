{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rambla-visual-plan-1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "transcript_signature": {
      "type": "string",
      "minLength": 1
    },
    "global_topic": {
      "type": "string",
      "minLength": 1
    },
    "visual_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "covered_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "BROLL",
              "KEEP_TALKING_HEAD",
              "CONTINUE_PREVIOUS_VISUAL"
            ]
          },
          "editorial_function": {
            "type": "string",
            "minLength": 1
          },
          "core_meaning": {
            "type": "string",
            "minLength": 1
          },
          "subtext": {
            "type": "string"
          },
          "visual_mode": {
            "enum": [
              "single",
              "sequence",
              "juxtaposition"
            ]
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shot_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "image_queries": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true
                },
                "video_queries": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true
                }
              },
              "required": [
                "shot_id",
                "description",
                "image_queries",
                "video_queries"
              ]
            },
            "maxItems": 3
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "continuation_from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "covered_chunk_ids",
          "original_text",
          "action",
          "editorial_function",
          "core_meaning",
          "subtext",
          "visual_mode",
          "shots",
          "avoid"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "BROLL"
                }
              }
            },
            "then": {
              "properties": {
                "shots": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "shots": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "CONTINUE_PREVIOUS_VISUAL"
                }
              }
            },
            "then": {
              "required": [
                "continuation_from"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "continuation_from"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "BROLL"
                },
                "visual_mode": {
                  "const": "single"
                }
              }
            },
            "then": {
              "properties": {
                "shots": {
                  "maxItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "BROLL"
                },
                "visual_mode": {
                  "enum": [
                    "sequence",
                    "juxtaposition"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "shots": {
                  "minItems": 2
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "transcript_signature",
    "global_topic",
    "visual_beats"
  ]
}